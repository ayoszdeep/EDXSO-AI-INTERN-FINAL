# Copy to .env.local for local runs and add the same variables in Vercel → Settings → Environment Variables.
# With no keys the app runs end-to-end on the clearly labelled test dataset.

# Public search index for live post discovery + lookalike profile search (https://serper.dev, free tier)
SERPER_API_KEY=
# Alternative search index, used only when SERPER_API_KEY is empty (https://tavily.com)
TAVILY_API_KEY=

# Licensed provider for public post commenters (https://apify.com → Settings → API & Integrations)
APIFY_API_TOKEN=
# Optional: swap the comments actor (default harvestapi~linkedin-post-comments)
APIFY_COMMENTS_ACTOR=

# Google Gemini for embeddings + persona classification (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional model overrides (otherwise discovered at runtime via models.list)
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
